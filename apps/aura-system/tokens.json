{
  "meta": {
    "name": "Aura System do Zeus Project",
    "source": "https://ai-developer.aura.build/",
    "method": "audited-html-css-js-plus-zeus-extension"
  },
  "fonts": {
    "sans": "\"Inter\", \"Manrope\", system-ui, sans-serif",
    "display": "\"Inter\", \"Geist\", system-ui, sans-serif",
    "serif": "\"Newsreader\", \"Playfair Display\", serif",
    "mono": "\"IBM Plex Mono\", \"Geist Mono\", monospace"
  },
  "themes": {
    "light": {
      "colors": {
        "background": "hsl(0 0% 100%)",
        "foreground": "hsl(0 0% 9%)",
        "surface": "hsl(0 0% 98%)",
        "surfaceStrong": "hsl(0 0% 96%)",
        "border": "hsl(0 0% 90%)",
        "borderStrong": "hsl(0 0% 84%)",
        "muted": "hsl(220 8% 40%)",
        "primary": "#2563eb",
        "primaryStrong": "#1d4ed8",
        "primarySoft": "#60a5fa",
        "primaryForeground": "#ffffff",
        "card": "rgba(255, 255, 255, 0.9)",
        "overlay": "rgba(255, 255, 255, 0.74)",
        "success": "#16a34a",
        "warning": "#f59e0b",
        "danger": "#ef4444",
        "info": "#0ea5e9"
      }
    },
    "dark": {
      "colors": {
        "background": "#07111f",
        "foreground": "#eef4ff",
        "surface": "rgba(15, 23, 42, 0.72)",
        "surfaceStrong": "rgba(15, 23, 42, 0.9)",
        "border": "rgba(148, 163, 184, 0.22)",
        "borderStrong": "rgba(148, 163, 184, 0.36)",
        "muted": "rgba(226, 232, 240, 0.72)",
        "primary": "#60a5fa",
        "primaryStrong": "#3b82f6",
        "primarySoft": "#93c5fd",
        "primaryForeground": "#07111f",
        "card": "rgba(8, 15, 29, 0.82)",
        "overlay": "rgba(7, 17, 31, 0.76)",
        "success": "#4ade80",
        "warning": "#fbbf24",
        "danger": "#fb7185",
        "info": "#38bdf8"
      }
    }
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "radius": {
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "xl": "1.5rem",
    "2xl": "2rem",
    "pill": "9999px"
  },
  "shadow": {
    "xs": "0 1px 2px rgba(15, 23, 42, 0.06)",
    "sm": "rgba(15, 23, 42, 0.04) 0 0 0 1px, rgba(15, 23, 42, 0.05) 0 3px 8px -4px",
    "md": "rgba(15, 23, 42, 0.05) 0 0 0 1px, rgba(15, 23, 42, 0.08) 0 12px 24px -16px, rgba(96, 165, 250, 0.08) 0 18px 48px -24px",
    "lg": "rgba(15, 23, 42, 0.08) 0 0 0 1px, rgba(15, 23, 42, 0.12) 0 24px 56px -28px, rgba(37, 99, 235, 0.14) 0 24px 80px -32px"
  },
  "motion": {
    "durationFast": "180ms",
    "durationBase": "300ms",
    "durationSlow": "800ms",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeInOut": "cubic-bezier(0.25, 1, 0.5, 1)",
    "patterns": [
      "lift",
      "pulse-slide",
      "spotlight",
      "shimmer"
    ]
  },
  "layout": {
    "container": "1400px"
  }
}
